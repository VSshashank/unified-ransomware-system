# URDS local development environment
# Copy this file to .env before running docker-compose.

# This secret is committed, so any token signed with it can be forged by anyone
# holding the repository. The gateway warns about it on every start and refuses
# to start at all when URDS_ENV is production/staging. Change it before this
# leaves a development machine.
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# development | staging | production. Only "development" tolerates the defaults
# above and below.
URDS_ENV=development

# POST /auth/token is a Phase 4 placeholder that verifies no identity. Set false
# to remove it. An empty POST yields a "free" token, which can read but not act;
# a role or tier above free requires DEV_TOKEN_BOOTSTRAP_SECRET in the
# X-Bootstrap-Secret header.
ALLOW_DEV_TOKENS=true
DEV_TOKEN_BOOTSTRAP_SECRET=dev-bootstrap-change-me

MONITOR_URL=http://monitor:8001
ML_URL=http://ml_engine:8002
LEDGER_URL=http://ledger:8003
RESPONSE_URL=http://response:8004
GATEWAY_URL=http://gateway:8000

LOG_LEVEL=INFO
WATCH_PATH=/watch
MODEL_PATH=/models/xgboost_model.pkl

# Ledger + recovery (SI)
LEDGER_DB_PATH=/app/data/ledger.db
# Stands in for VSS inside the Linux container. On a Windows host running the
# response service natively, leave this unset to use real shadow copies.
RECOVERY_SNAPSHOT_ROOT=/app/snapshots
