# URDS local development environment
# Copy this file to .env before running docker-compose.

JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

MONITOR_URL=http://monitor:8001
ML_URL=http://ml_engine:8002
LEDGER_URL=http://ledger:8003
RESPONSE_URL=http://response:8004
GATEWAY_URL=http://gateway:8000

LOG_LEVEL=INFO
WATCH_PATH=/watch
MODEL_PATH=/models/xgboost_model.pkl

# Ledger + recovery (SI)
LEDGER_DB_PATH=/app/data/ledger.db
# Stands in for VSS inside the Linux container. On a Windows host running the
# response service natively, leave this unset to use real shadow copies.
RECOVERY_SNAPSHOT_ROOT=/app/snapshots
